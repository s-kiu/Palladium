# deps / build output
node_modules/
dist/
.angular/
*.tsbuildinfo

# local env & secrets
.env
*.local

# maintainer working notes — not part of the published repo
/todo*.md

# local experiments and mods that are not part of the published project
/bridge-mods/

# runtime data created by compose bind mounts (user content, not source)
/mods/*
/paks/*
/logicmods/*
/backups/*
!/mods/.gitkeep
# This project's own mods are source, not user content — they ship here.
!/mods/Palladium/
# …but what a mod writes beside itself is runtime state, not source.
/mods/*/*.config
/mods/*/*.data
# A shipped, commented settings example is source: the framework copies it
# to settings.config on the first load that finds none.
!/mods/*/settings.example.config

# The example mods are source only. If you copy one into ./mods to run it, the
# live settings.config and .data it grows there are ignored by the rules above;
# nothing runtime belongs beside the examples themselves.
/examples/lua/*/*.data
/examples/lua/*/*.config
!/examples/lua/*/settings.example.config
# The commented tour of the permission system is documentation, not state.
!/mods/Palladium/example.permissions.config

# Palladium keeps one folder per owner under mods/ — settings, records and
# generated files, all written at runtime. Only the catalog is source: the
# build writes it and CI checks it for drift.
/mods/Palladium/mods/*
!/mods/Palladium/mods/Palladium/
/mods/Palladium/mods/Palladium/*
!/mods/Palladium/mods/Palladium/generated/
/mods/Palladium/mods/Palladium/generated/*
!/mods/Palladium/mods/Palladium/generated/catalog.ref
!/paks/.gitkeep
!/logicmods/.gitkeep
!/backups/.gitkeep
/data/

# editor and tool scratch
/.claude/

# vendored UE4SS artifacts are fetched by vendor.sh, never committed
packages/server-image/ue4ss/vendor/*
!packages/server-image/ue4ss/vendor/.gitkeep

# editor / os noise
.DS_Store
*.log
.idea/
.vscode/

# mkdocs build output — the docs workflow builds it fresh
/site/
