; WelcomeKit — what a first-ever join receives, and whether to announce it.
;
; On first load this file becomes settings.config, and from then on that
; copy is yours: edits apply within seconds on a running server, survive
; mod updates, and this example is never copied over it again.
;
; Mentioning `items` here replaces the whole kit — list every item you want
; handed over. Item ids are the game's internal names: bread is Pan,
; medical supplies are Medicines, gold is Money.

items.1.item = PalSphere
items.1.count = 10

items.2.item = Pan
items.2.count = 5

announce = true
