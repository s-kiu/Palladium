; example.permissions.config — a tour of everything the permission system can
; express, in a file shaped exactly like the real permissions.config.
;
; This file is never read by anything. Copy lines into permissions.config (or
; replace it outright); the agent re-reads that file within two seconds, no
; restart. Note that the real file is rewritten whenever the panel, a mod or
; a grant changes it, and comments do not survive that — which is why the
; commentary lives here.
;
; How a call is resolved, in order:
;   1. the player's own [players] overrides win outright,
;   2. then their groups, highest weight first,
;   3. then the default group everybody is in,
;   4. then the node's registered default — deny, if nobody registered it.
; Within one source an exact node beats `pal.*` beats `*`, and deny beats
; allow on ties. The first source that has an answer decides; a constrained
; allow whose constraint fails is a refusal, not a fall-through.

; ── groups ──────────────────────────────────────────────────────────────────
; A group is a name, a weight, an optional [TAG] shown in chat, and entries.
; Weight orders resolution and is also what rank constraints measure:
; a target's "standing" is their highest-weight group.

; Everybody lands in the default group. Keeping it empty means new players
; get only what the [nodes] section allows by default (the perk mods below).
[groups guest]
is_default = true
weight = 0

; `where target = @me` narrows a grant to self-service: the command works on
; the caller and refuses anyone else. `target` is the id the call is aimed
; at, spelled @me when it is the caller's own.
[groups member]
allow = player.position where target = @me
allow = player.stats where target = @me
allow = permission.check where target = @me
allow = pal.list
is_default = false
tag = MEMBER
weight = 5

; `until <stamp>` ends a grant on its own: `2026-09-01` dies at midnight
; starting that day (server-local), `2026-09-01T14:30` at that minute. An
; expired entry is simply not there anymore — nothing to revoke. The stamp
; goes last, after any constraint. This is the shape of a purchased VIP
; month: set the entry with the date and forget it.
[groups vip]
allow = player.position where target = @me
allow = player.stats where target = @me
allow = permission.check where target = @me
allow = pal.list
allow = player.heal where target = @me
allow = pal.inspect until 2026-09-01
is_default = false
tag = VIP
weight = 8

; Rank constraints. The resolver hands every constraint three derived
; fields — target (id or @me), target_group (the target's highest-weight
; group name) and target_weight (that group's weight) — so a grant can say
; who it may be aimed at:
;
;   target_weight < 12        anyone strictly below this group: the hierarchy
;   target_group != admins    everyone except one group: an exclude
;   target_group in member,vip  only these groups: an include
;
; Acting on yourself always passes: @me weighs -1, beneath every group, so a
; moderator's own !teleport never goes dark because of their own rank.
;
; `or` joins alternatives and `and` binds tighter: "a and b or c" is
; (a and b) or (c). The whole entry passes when any alternative does.
;
; `group_weight` is the same idea for calls that name a group rather than a
; player (group.assign, group.set_entry): the weight of the named group. A
; moderator who may assign only below their own rank can promote a member to
; vip but cannot mint another moderator — or an admin.
[groups moderator]
allow = player.position
allow = player.stats
allow = permission.check
allow = pal.list
allow = pal.inspect
allow = player.heal where target_group in guest,member,vip
allow = player.teleport where target = @me or target_weight < 12
allow = server.announce
allow = location.save
allow = location.delete
allow = group.assign where group_weight < 12
allow = group.list
allow = permission.player
is_default = false
tag = MOD
weight = 12

; `*` is every node, present and future: a capability added next release is
; admin-usable the moment it registers, no config edit. An exact entry in the
; same group would still beat it — deny = server.announce next to allow = *
; would switch that one node off.
[groups admins]
allow = *
is_default = false
tag = ADMINS
weight = 15

; ── nodes ───────────────────────────────────────────────────────────────────
; Every node the installed mods registered, with its default — the answer
; when no group or override says otherwise. Mods own their nodes and
; register them on load; an operator's edit here outranks the mod's wish.
; Only a slice is shown; the real file lists all of them.
[nodes]
dailybonus.reward = allow    ; perks stay on for everybody, including guests
goldstreak.reward = allow
welcomekit.kit = allow
mimogride.ride = allow
pal.spawn = deny             ; capability nodes default to deny: admin surface
player.teleport = deny
permission.grant = deny

; ── players ─────────────────────────────────────────────────────────────────
; Group membership and per-player overrides, by 32-hex player id (the panel
; shows it, `!position target=@Name` answers with it). Overrides win over
; every group and take the same constraint and until forms as group entries.

; The operator: member of admins, nothing else needed.
[players F8EAA197000000000000000000000000]
groups = admins

; A player in two groups: the higher-weight one is consulted first, and its
; tag is the one shown in chat.
[players 1111111100000000000000000000AAAA]
groups = moderator
groups = vip

; Overrides, three shapes. A personal grant with an expiry — a week of spawn
; rights, limited to one species and low levels, gone by itself; a personal
; deny that switches one command off for one player no matter what their
; groups say; and membership plus an extra on top.
[players 2222222200000000000000000000BBBB]
allow = pal.spawn where species in SheepBall,Lamball and level <= 20 until 2026-08-14
deny = mimogride.ride

[players 3333333300000000000000000000CCCC]
groups = member
allow = player.heal where target = @me
