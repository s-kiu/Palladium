; Leaderboards — how fresh, and how many.
;
; On first load this file becomes settings.config, and from then on that
; copy is yours: edits apply within seconds on a running server, survive
; mod updates, and this example is never copied over it again.
;
; refresh_minutes — how often standings are re-read from the engine. !lb
; never triggers a refresh itself; it answers from the last one, and says
; how long until the next.
; top — how many names !lb lists.
; default_board — which board a bare !lb shows. One of level, playtime,
; captured, fished, crafted, bosses. A fishing server is not obliged to
; lead with levels. A name that is not a board falls back to level.

refresh_minutes = 5
top = 3
default_board = level
