; AdminCommands — the nodes this mod owns.
;
; Every one defaults to deny, which is the point: installing the mod hands
; nobody anything. Grant them in Mods/Palladium/permissions.config to the group
; that should have them, for example:
;
;   [groups moderator]
;   allow = admincommands.tp
;   allow = admincommands.give where item in PalSphere,Pan and count <= 10
;   allow = admincommands.slay where target_weight < 12
;
; The `where` clauses are Palladium's, not this mod's — any grant can be
; narrowed that way, including to `target = @me` for a command someone may only
; point at themselves.

[admincommands.tp]
default = deny
description = teleport yourself or another player

[admincommands.give]
default = deny
description = give items to a player

[admincommands.slay]
default = deny
description = kill a player outright

[admincommands.god]
default = deny
description = make a player effectively unkillable

[admincommands.mute]
default = deny
description = stop a player using chat commands
