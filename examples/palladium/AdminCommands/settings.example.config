; AdminCommands — settings.
;
; This file appears on the first load, copied from the shipped example. Edits
; are picked up within seconds on a running server; mod updates never touch it.

; What god mode raises a player's maximum health to. There is no invincibility
; flag on this build, so god mode is a ceiling nothing in the world reaches
; rather than true immunity — see the README.
god_hp = 99999999

; Tell everyone when an admin slays somebody, so a death nobody caused in game
; is not a mystery. false keeps it between the admin and the victim.
announce_slay = true
