; TimedRewards — the operator's ladder.
;
; On first load this file becomes settings.config, and from then on that
; copy is yours: edits apply within seconds on a running server, survive
; mod updates, and this example is never copied over it again.
;
; Any top-level key mentioned in settings.config replaces the mod's default
; wholesale — so always list the WHOLE ladder, not just the marks you
; changed. hours = total hours played on this server. Item ids are the
; game's internal names (gold is Money, bread is Pan); pal names in
; commands work in English, but items here want the id.

rewards.1.hours = 1
rewards.1.item = PalSphere
rewards.1.count = 5

rewards.2.hours = 5
rewards.2.item = Money
rewards.2.count = 500

rewards.3.hours = 10
rewards.3.item = Money
rewards.3.count = 1500
