; TimedRewards — the permission nodes this mod owns.
;
; A mod can declare its nodes in mod.lua and stay one file, or move them here.
; When this file is present it is the whole truth: the `permissions` table in
; mod.lua is not read at all, so what you see here is what the mod owns.
;
; One section per node. `default` is allow or deny and is what applies to a
; player no permissions.config in Mods/Palladium mentions. `description` is
; what the panel and `?command` show. Every node must start with the mod's
; own name — a mod cannot declare permissions for anything else.
;
; Full-line comments only (; or #). Edits apply at the next server restart,
; because nodes are registered as a mod loads.

[timedrewards.reward]
default = allow
description = earn the playtime milestone rewards

[timedrewards.check]
default = allow
description = ask about your next milestone with !rewards
