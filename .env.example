# ── pal-up server configuration ────────────────────────────────────────────
# Copy to .env and edit. Every value here becomes part of the generated
# PalWorldSettings.ini (unless SETTINGS_MODE=manual) or controls the container.
# Full reference: packages/server-image/README.md

# ── Required ─────────────────────────────────────────────────────────────────
# Admin password: used in-game AND as the credential for the local REST admin
# API. The container refuses to start without it. Make it long and random.
ADMIN_PASSWORD=

# ── Server identity ──────────────────────────────────────────────────────────
SERVER_NAME=Palworld Server (Pal-Up)
SERVER_DESCRIPTION=
# Empty = no join password
SERVER_PASSWORD=
MAX_PLAYERS=32

# ── Network ──────────────────────────────────────────────────────────────────
GAME_PORT=8211
# Set PUBLIC_IP only if the server is behind NAT and auto-detection fails.
PUBLIC_IP=
#PUBLIC_PORT=8211

# ── Updates ──────────────────────────────────────────────────────────────────
# true  = check & apply Steam updates on every container start (default)
# false = install if missing, never update
# hold  = install if missing; if an update exists, log a warning and KEEP the
#         current version until you flip this back to true. Use this to protect
#         mods from game patches.
UPDATE_ON_BOOT=true
# Re-validate all game files on boot (slow; use after suspected corruption)
VALIDATE_ON_BOOT=false

# ── Mods (UE4SS) ─────────────────────────────────────────────────────────────
# The UE4SS mod loader is baked into the image at build time (checksum-pinned,
# see packages/server-image/ue4ss/ue4ss.lock). Set to false to run unmodded.
MODS_ENABLED=true
# managed = regenerate mods.txt from ./mods on every boot (default)
# manual  = never touch mods.txt (you maintain it yourself)
MODS_TXT_MODE=managed
# If the server crashes 3× in quick succession with UE4SS active (usually a
# game patch the loader doesn't support yet), restart unmodded instead of
# crash-looping. Set to false to insist on modded-or-nothing.
#MODS_AUTO_FALLBACK=true

# ── Backups ──────────────────────────────────────────────────────────────────
BACKUP_ON_STOP=true
BACKUP_BEFORE_UPDATE=true
# 0 disables scheduled backups; e.g. 240 = every 4 h
BACKUP_INTERVAL_MINUTES=240
# Retention: prune to the newest N archives (0 = unlimited) …
BACKUP_KEEP_COUNT=14
# … and/or delete archives older than N days (0 = disabled)
BACKUP_KEEP_DAYS=0

# ── Performance ──────────────────────────────────────────────────────────────
# Server tick rate cap. The engine targets 60; raising to e.g. 120 makes
# combat/movement smoother for players but costs significantly more CPU and
# bandwidth, and busy bases may not keep up. Leave unset for the default.
#SERVER_TICKRATE=120

# ── Shutdown behaviour ───────────────────────────────────────────────────────
# Seconds of warning players get before a graceful stop
SHUTDOWN_WARN_SECONDS=30
SHUTDOWN_MESSAGE=Server is shutting down

# ── Gameplay (optional — remove the # to override game defaults) ─────────────
#DIFFICULTY=None
#DEATH_PENALTY=All            # None | Item | ItemAndEquipment | All
#EXP_RATE=1.0
#PAL_CAPTURE_RATE=1.0
#PAL_SPAWN_NUM_RATE=1.0
#DAY_TIME_SPEED_RATE=1.0
#NIGHT_TIME_SPEED_RATE=1.0
#WORK_SPEED_RATE=1.0
#ITEM_WEIGHT_RATE=1.0
#ENEMY_DROP_ITEM_RATE=1.0
#PVP=false
#HARDCORE=false
#PAL_LOST=false
#INVADER_ENEMY=true
#CROSSPLAY_PLATFORMS=(Steam,Xbox,PS5,Mac)

# Any PalWorldSettings.ini key not covered above can be set verbatim with an
# OPT_ prefix. Strings need explicit quotes, e.g.:
#OPT_PalEggDefaultHatchingTime=72.0
#OPT_Region="EU"

# ── Web panel ────────────────────────────────────────────────────────────────
# The panel signs you in with ADMIN_PASSWORD (set above) and keeps a session
# cookie until you sign out. Plain HTTP — expose on your LAN / VPN only.
PANEL_PORT=3000
# Which host address the panel listens on. The default makes it reachable from
# your LAN (normal homelab setup — the internet still can't reach it unless
# your router forwards port 3000). On a VPS or any host with a PUBLIC IP, set
# this to 127.0.0.1 and connect via SSH tunnel or a TLS reverse proxy instead.
#PANEL_BIND=0.0.0.0
# Session lifetime; sessions renew themselves while you keep using the panel.
#SESSION_TTL_DAYS=30
# Set to pin the cookie-signing secret; otherwise one is generated and stored
# in the data volume on first start.
#SESSION_SECRET=
# The panel's Connect card detects your public IP via api.ipify.org (cached,
# server-side). Set to false to disable the external lookup; with PUBLIC_IP
# set above, no lookup happens either way.
#PUBLIC_IP_LOOKUP=true

# ── Container system ─────────────────────────────────────────────────────────
# UID/GID that owns /palworld inside the container. Match your host user so
# ./mods & ./backups are editable without sudo (id -u / id -g).
PUID=1000
PGID=1000
TZ=Etc/UTC
# Extra flags appended to the PalServer launch command
#SERVER_ARGS=
